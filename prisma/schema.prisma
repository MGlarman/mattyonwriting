generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  displayName  String
  passwordHash String
  createdAt    DateTime  @default(now())
  reviews      Review[]
  comments     Comment[]
  reviewLikes  ReviewLike[]
  commentLikes CommentLike[]
  sessions     Session[]
  readingList  ReadingListItem[]
}
model Session {
  tokenHash String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}
model Book {
  id          String   @id @default(cuid())
  workId      String   @unique
  title       String
  authors     String[]
  coverId     Int?
  firstYear   Int?
  description String?
  subjects    String[] @default([])
  series      String?
  seriesNumber Float?
  createdAt   DateTime @default(now())
  reviews     Review[]
  readingList ReadingListItem[]
}
model Review {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  rating    Int
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  comments  Comment[]
  likes     ReviewLike[]
  @@unique([userId, bookId])
  @@index([bookId, createdAt])
}
model Comment {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  body      String
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes     CommentLike[]
  @@index([reviewId, createdAt])
  @@index([userId])
}
model ReviewLike {
  userId    String
  reviewId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  @@id([userId, reviewId])
  @@index([reviewId])
}
model CommentLike {
  userId    String
  commentId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  @@id([userId, commentId])
  @@index([commentId])
}
model AuthAttempt {
  key         String   @id
  count       Int      @default(1)
  windowStart DateTime @default(now())
  @@index([windowStart])
}
enum ReadingStatus {
  TO_READ
  READING
  READ
}
model ReadingListItem {
  userId    String
  bookId    String
  status    ReadingStatus
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  @@id([userId, bookId])
  @@index([userId, status, updatedAt])
}
